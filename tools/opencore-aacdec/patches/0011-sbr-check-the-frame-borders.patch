+     * run past the trailing border, and the envelope adjustment wrote QMF
+     * slots past its buffers, over the SBR frame data.
+     */
+    for (env = 0; env < bs_num_env; env++)
+    {
+        if (tE[env + 1] < tE[env])
+        {
+            return SBRDEC_INVALID_BITSTREAM;
         }
     }
 

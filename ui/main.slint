export component MainWindow inherits Window {
    width: 368px;
    height: 448px;
    background: #f5f5f5;
    forward-focus: keys;

    property <int> count;

    // The firmware forwards the BOOT button as the Return key; a click
    // counts on release, like a TouchArea click.
    keys := FocusScope {
        property <bool> pressed;

        key-pressed(event) => {
            if (event.text == Key.Return) {
                self.pressed = true;
                return accept;
            }
            reject
        }
        key-released(event) => {
            if (event.text == Key.Return) {
                if (self.pressed) {
                    root.count += 1;
                }
                self.pressed = false;
                return accept;
            }
            reject
        }

        VerticalLayout {
            alignment: center;
            spacing: 24px;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 240px;
                    height: 72px;
                    background: keys.pressed || touch.pressed ? #1e40af : #2563eb;
                    border-radius: 16px;

                    Text {
                        text: "Click me";
                        color: white;
                        font-size: 24px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }

                    touch := TouchArea {
                        clicked => {
                            root.count += 1;
                        }
                    }
                }
            }

            Text {
                text: root.count;
                color: #1f2937;
                font-size: 48px;
                horizontal-alignment: center;
            }
        }
    }
}

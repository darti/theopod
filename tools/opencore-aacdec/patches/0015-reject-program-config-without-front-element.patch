--- a/get_prog_config.cpp
+++ b/get_prog_config.cpp
@@ -17,6 +17,7 @@
  *
  * Modified by theo-pod (t-169): sampling-frequency indices above 11 are
  * rejected.
+ * A program config without a front element is rejected.
  */
 /*
 

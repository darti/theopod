--- a/pns_intensity_right.cpp
+++ b/pns_intensity_right.cpp
@@ -14,6 +14,9 @@
  * See the License for the specific language governing permissions
  * and limitations under the License.
  * -------------------------------------------------------------------
+ *
+ * Modified by theo-pod (t-169): the PNS/intensity walk stops on an
+ * inconsistent group table.
  */
 /*
 
@@ -475,6 +478,16 @@
         -----------------------------------------------------------*/
         partition = *(pGroup++);
 
+        /*
+         * theo-pod (t-169): a group table left inconsistent by a corrupt
+         * frame did not advance or ran past the windows, and the walk read
+         * past mask[] and the decoder state.
+         */
+        if ((partition <= window_start) || (partition > pFrameInfo->num_win))
+        {
+            break;
+        }
+
         band_start = 0;
 
         wins_in_group = (partition - window_start);

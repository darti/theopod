@@ -127,15 +129,31 @@
 ; FUNCTION CODE
 ----------------------------------------------------------------------------*/
 
+/*
+ * theo-pod (t-169): loads the next 16 bits, reading only bytes inside
+ * bufferLen and loading zeros past it. The readers went on reading past
+ * the SBR payload, its stream structure and the decoder state.
+ * nrBitsRead + buffered_bits is the number of bits loaded so far.
+ */
+static void buf_refill(BIT_BUFFER * hBitBuf)
+{
+    UInt32 pos = (hBitBuf->nrBitsRead + hBitBuf->buffered_bits) >> 3;
+    UInt32 len = hBitBuf->bufferLen >> 3;
+    UInt32 hi = (pos < len) ? hBitBuf->char_ptr[0] : 0;
+    UInt32 lo = (pos + 1 < len) ? hBitBuf->char_ptr[1] : 0;
+
+    hBitBuf->char_ptr += 2;
+    hBitBuf->buffer_word    = (hBitBuf->buffer_word << 16) | (hi << 8) | lo;
+    hBitBuf->buffered_bits += 16;
+}
+
 UInt32 buf_getbits(BIT_BUFFER * hBitBuf, Int32 n)
 {
 
     /* read bits from MSB side */
     if (hBitBuf->buffered_bits <= 16)
     {
-        hBitBuf->buffer_word    = (hBitBuf->buffer_word << 16) | (*(hBitBuf->char_ptr++) << 8);
-        hBitBuf->buffer_word   |= *(hBitBuf->char_ptr++);
-        hBitBuf->buffered_bits += 16;
+        buf_refill(hBitBuf);
     }
 
     hBitBuf->buffered_bits -= n;
@@ -152,9 +170,7 @@
     /* read bits from MSB side */

@@ -115,7 +118,24 @@
 #define Q28fmt(x)   (Int32)(x*((Int32)1<<28) + (x>=0?0.5F:-0.5F))
 #define Q15fmt(x)   (Int32)(x*((Int32)1<<15) + (x>=0?0.5F:-0.5F))
 
+/*
+ * theo-pod (t-169): aligns two mantissas on the larger exponent. Exponents
+ * come from the stream's envelope data, so their difference can reach 32
+ * or more, an undefined shift; the arithmetic result is then 0 or -1,
+ * which a shift by 31 gives.
+ */
+static inline Int32 sbr_align(Int32 man, Int32 shift)
+{
+    return man >> ((shift < 0) ? 0 : ((shift > 31) ? 31 : shift));
+}
 
+/* theo-pod (t-169): the same clamp for a left shift by a stream exponent. */
+static inline Int32 sbr_shl(Int32 man, Int32 shift)
+{
+    return man << ((shift < 0) ? 0 : ((shift > 31) ? 31 : shift));
+}

--- a/get_tns.cpp
+++ b/get_tns.cpp
@@ -14,6 +14,8 @@
  * See the License for the specific language governing permissions
  * and limitations under the License.
  * -------------------------------------------------------------------
+ *
+ * Modified by theo-pod (t-169): the TNS filter bottom is clamped at band 0.
  */
 /*
 
@@ -459,6 +461,17 @@
                 top -= get9_n_lessbits(num_start_band_bits,
                                        pInputStream);
 
+                /*
+                 * theo-pod (t-169): ISO/IEC 14496-3 takes
+                 * bottom = max(top - length, 0). A negative top wrapped into
+                 * a huge unsigned start band, and apply_tns() then walked
+                 * win_sfb_top[] and coef[] past their ends.
+                 */
+                if (top < 0)
+                {
+                    top = 0;
+                }
+
                 tempInt = MINIMUM(top, tns_bands);
 
                 pFilt->start_coef = SCALE_FACTOR_BAND_OFFSET(tempInt);

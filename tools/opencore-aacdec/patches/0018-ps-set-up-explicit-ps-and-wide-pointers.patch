  * -------------------------------------------------------------------
+ *
+ * Modified by theo-pod (t-169): the PS pointer arrays are sized and aligned
+ * for pointers wider than Int32.
  */
 /*
 
@@ -89,6 +92,7 @@
 
 #ifdef PARAMETRICSTEREO
 
+#include    <stdint.h>  /* theo-pod (t-169): uintptr_t */
 #include    "s_sbr_channel.h"
 #include    "aac_mem_funcs.h"
 #include    "ps_hybrid_filter_bank_allocation.h"
@@ -285,6 +289,20 @@
         h_ps_dec->aaImagDelayBufferSubQmf[i] = (Int32 *)ptr1;
         ptr1 += DELAY_ALLPASS;
 
+    }
+
+    /*
+     * theo-pod (t-169): the word counts above take a pointer for one Int32,
+     * so on a 64-bit host the serial delay pointer arrays overlapped each
+     * other and were misaligned. There, move these buffers past ptr7 (still
+     * inside the unused right channel, before its synthesis history V[]),
+     * align them and size the pointer arrays as pointers. The 32-bit
+     * firmware layout is unchanged.
+     */
+    if (sizeof(Int32 *) > sizeof(Int32))
+    {
+        ptr2 = (Int32 *)(((uintptr_t)ptr7 + sizeof(Int32 *) - 1) & ~(uintptr_t)(sizeof(Int32 *) - 1));
+        ptr3 = ptr2 + 504 + 2 * (3 + 4 + 5) * (sizeof(Int32 *) / sizeof(Int32) - 1);
     }
 
     for (i = 0 ; i < NO_SERIAL_ALLPASS_LINKS ; i++) /*  NO_SERIAL_ALLPASS_LINKS == 3 */
@@ -293,16 +311,16 @@
         h_ps_dec->aDelayRBufIndexSer[i] = 0;
 
         h_ps_dec->aaaRealDelayRBufferSerQmf[i] = (Int32 **)ptr2;
-        ptr2 += aRevLinkDelaySer[i];
+        ptr2 += aRevLinkDelaySer[i] * sizeof(Int32 *) / sizeof(Int32);
 
         h_ps_dec->aaaImagDelayRBufferSerQmf[i] = (Int32 **)ptr2;
-        ptr2 += aRevLinkDelaySer[i];
+        ptr2 += aRevLinkDelaySer[i] * sizeof(Int32 *) / sizeof(Int32);
 
         h_ps_dec->aaaRealDelayRBufferSerSubQmf[i] = (Int32 **)ptr3;
-        ptr3 += aRevLinkDelaySer[i];
+        ptr3 += aRevLinkDelaySer[i] * sizeof(Int32 *) / sizeof(Int32);
 
         h_ps_dec->aaaImagDelayRBufferSerSubQmf[i] = (Int32 **)ptr3;
-        ptr3 += aRevLinkDelaySer[i];
+        ptr3 += aRevLinkDelaySer[i] * sizeof(Int32 *) / sizeof(Int32);
 
         for (j = 0; j < aRevLinkDelaySer[i]; j++)
         {

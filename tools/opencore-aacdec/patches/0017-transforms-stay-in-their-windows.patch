+++ b/trans4m_freq_2_time_fxp.cpp
@@ -16,6 +16,7 @@
  * -------------------------------------------------------------------
  *
  * Modified by theo-pod (t-169): keep the IMDCT output shifts within 0..31
+ * and do not read the window tables past their end.
  */
 /*
 
@@ -1237,7 +1238,8 @@
                     *(pOverlap_and_Add_Buffer_1++)  =  fxp_mul_16_by_16(dat1, win1) >> shift;
 
                     dat1 = *(pFreq_2_Time_data_1++);
-                    win1 = *(pShort_Window_1++);
+                    /* theo-pod (t-169): no prefetch past the window table. */
+                    win1 = (i > 1) ? *(pShort_Window_1++) : 0;
                 }
 
                 /* -------- segment C ---------------*/
@@ -1371,7 +1373,8 @@
                 *(pOverlap_and_Add_Buffer_1++) += temp;
 
                 dat1 = *(pFreq_2_Time_data_2++);
-                win1 = *(pShort_Window_2--);
+                /* theo-pod (t-169): no prefetch past the window table. */
+                win1 = (i > 1) ? *(pShort_Window_2--) : 0;
             }
 
         }   /* if (exp < 16) */
@@ -2267,7 +2270,8 @@
                     *(pOverlap_and_Add_Buffer_1++)  =  fxp_mul_16_by_16(dat1, win1) >> shift;
 
                     dat1 = *(pFreq_2_Time_data_1++);
-                    win1 = *(pShort_Window_1++);
+                    /* theo-pod (t-169): no prefetch past the window table. */
+                    win1 = (i > 1) ? *(pShort_Window_1++) : 0;
                 }
 
                 /* -------- segment C ---------------*/
@@ -2405,7 +2409,8 @@
                 *(pOverlap_and_Add_Buffer_1++) += temp;
 
                 dat1 = *(pFreq_2_Time_data_2++);
-                win1 = *(pShort_Window_2--);
+                /* theo-pod (t-169): no prefetch past the window table. */
+                win1 = (i > 1) ? *(pShort_Window_2--) : 0;
             }
 
 

  * and limitations under the License.
  * -------------------------------------------------------------------
+ *
+ * Modified by theo-pod (t-169): keep the M/S normalisation shifts within
+ * 0..31
  */
 /*
 
@@ -312,6 +315,12 @@
                  */
                 Int shift_left_chan  = 1 + tempInt;
 
+                /* theo-pod (t-169): a shift of 32 or more is undefined */
+                if (shift_left_chan > 31)
+                {
+                    shift_left_chan = 31;
+                }
+
                 /*
                  * Following code line is equivalent to...
                  * q_formatLeft  = q_formatRight - 1;
@@ -349,6 +358,12 @@
                  */
                 Int shift_right_chan = 1 - tempInt;
 
+                /* theo-pod (t-169): a shift of 32 or more is undefined */
+                if (shift_right_chan > 31)
+                {
+                    shift_right_chan = 31;
+                }
+
                 /*
                  * Following code line is equivalent to...
                  * q_formatRight = q_formatLeft - 1;

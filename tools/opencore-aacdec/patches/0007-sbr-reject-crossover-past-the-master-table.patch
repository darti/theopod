--- a/sbr_reset_dec.cpp
+++ b/sbr_reset_dec.cpp
@@ -14,6 +14,9 @@
  * See the License for the specific language governing permissions
  * and limitations under the License.
  * -------------------------------------------------------------------
+ *
+ * Modified by theo-pod (t-169): a crossover band outside the master table is
+ * rejected.
  */
 /*
 
@@ -173,6 +176,17 @@
     }
 
     /*Derive Hiresolution from master frequency function*/
+
+    /*
+     * theo-pod (t-169): the crossover band must lie inside the master table
+     * (ISO/IEC 14496-3 needs at least one high-resolution band). A larger
+     * xover_band made NSfb[HI] negative, and the low-resolution table was
+     * read before FreqBandTable[HI][0].
+     */
+    if (headerData->xover_band >= sbrDec->Num_Master)
+    {
+        return SBRDEC_ILLEGAL_SCFACTORS;
+    }
 
     sbrDec->NSfb[HI] = sbrDec->Num_Master - headerData->xover_band;
 

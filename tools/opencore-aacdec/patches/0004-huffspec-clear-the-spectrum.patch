--- a/huffspec_fxp.cpp
+++ b/huffspec_fxp.cpp
@@ -14,6 +14,9 @@
  * See the License for the specific language governing permissions
  * and limitations under the License.
  * -------------------------------------------------------------------
+ *
+ * Modified by theo-pod (t-169): the quantized spectrum is cleared before
+ * each frame.
  */
 /*
 
@@ -364,6 +367,15 @@
     }
 
     pSfb      = pSfbStart;
+
+    /*
+     * theo-pod (t-169): the sections may not cover every band of the
+     * window (a corrupt section table), and the rescaling loop below reads
+     * all of them. Without this, leftovers from a previous frame or from the
+     * memory this buffer shares reach esc_iquant_scaling() above the
+     * frame's max and index inverseQuantTable[] past its end.
+     */
+    pv_memset(quantSpec, 0, LN2 * sizeof(quantSpec[0]));
 
     /* decoding spectral values section by section */
     for (i = nsect; i > 0; i--)

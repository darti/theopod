 #define  ROUNDING_SCALED     (ROUNDING<<(16 - SCALING))
 
+/*
+ * theo-pod (t-169): imdct_fxp() returns an exponent derived from the
+ * stream's q-format, which a malformed stream can push far enough for the
+ * right shifts below to be negative or wider than 31 bits (undefined).
+ * Keep them within 0..31.
+ */
+static inline Int trans4m_shift(Int shift)
+{
+    return (shift < 0) ? 0 : ((shift > 31) ? 31 : shift);
+}
 
